# Local Euterpe development config

# API auth (or use .euterpe-api-keys via `pnpm run gen-key`)
EUTERPE_API_KEY=eut_local_dev_key

# Local queue DB
DATABASE_URL=file:./data/euterpe.sqlite

# Worker workload allowlist (comma-separated media:kind tokens)
EUTERPE_ALLOWED_WORKLOADS=audio:transcode

# Optional limits
# Accepts raw bytes or human-readable values: 10M, 50G, 512KiB, 5GiB
EUTERPE_MAX_INPUT_BYTES=5GiB

# Optional fallback signing secret for local/dev only.
# Production should use DB-backed `requester_signing_secrets` for per-requester
# secrets and key rotation without redeploys.
EUTERPE_WEBHOOK_SECRET=local-dev-webhook-secret

# Optional KEK settings for credential envelope encryption
# EUTERPE_KEK_ACTIVE_ID=local-dev
# EUTERPE_KEK_KEYS=local-dev:<base64-32-byte-key>
