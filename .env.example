# Euterpe API keys (comma-separated; optional if using .euterpe-api-keys file)
EUTERPE_API_KEY=eut_xxx
# EUTERPE_API_KEYS=eut_xxx,eut_yyy

# Job status DB. Omit for default file:./data/euterpe.sqlite (relative to cwd).
# DATABASE_URL=file:./data/euterpe.sqlite

# Storage is client-driven: each request includes storage config (R2/S3 credentials, bucket)
