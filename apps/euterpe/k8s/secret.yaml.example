apiVersion: v1
kind: Secret
metadata:
  name: euterpe-secrets
type: Opaque
stringData:
  EUTERPE_API_KEY: "eut_xxx"  # or EUTERPE_API_KEYS for comma-separated
  # Storage credentials are passed by the client in each request
---
# Apply with: kubectl apply -f secret.yaml
# Copy this file to secret.yaml and fill in real values. Do not commit secret.yaml.
