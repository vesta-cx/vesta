{
  "name": "vesta-cx",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:clean": "pnpm run clean && pnpm run build",
    "check-types": "turbo run check-types",
    "clean": "cleanc clean",
    "dev": "turbo run dev",
    "dev:clean": "pnpm run clean && pnpm run dev",
    "format": "turbo run format --filter='!./' && prettier --write .",
    "install:clean": "pnpm run clean && node -e \"try{require('fs').rmSync(require('path').join(process.cwd(),'node_modules'),{recursive:true,force:true})}catch(_){}\" && pnpm i",
    "lint": "turbo run lint",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "references": "./tools/scripts/setup-stack-references.sh"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^20.4.4",
    "@commitlint/config-conventional": "^20.4.4",
    "@vesta-cx/config": "workspace:*",
    "eslint": "^10.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "prettier-plugin-packagejson": "^3.0.0",
    "prettier-plugin-svelte": "^3.5.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.8.10",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@tailwindcss/oxide",
      "better-sqlite3",
      "esbuild",
      "msgpackr-extract",
      "sharp",
      "svelte-preprocess",
      "workerd"
    ],
    "ignoredBuiltDependencies": [
      "better-sqlite3",
      "svelte-preprocess"
    ]
  }
}
