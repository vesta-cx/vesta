{
    "schema": "https://json.schemastore.org/tsconfig",
    "extends": "@vesta-cx/config/typescript/tsup",
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.mts",
        "src/**/*.cts",
        "tests/**/*.ts",
        "tests/**/*.tsx",
        "tests/**/*.mts",
        "tests/**/*.cts"
    ],
    "exclude": ["dist", "node_modules", "tests"],
    "compilerOptions": {
        "rootDir": "src/",
        "outDir": "dist/",
        "declarationDir": "dist/",
        "target": "esnext",
        "lib": ["esnext", "dom"],
        "types": ["node"],
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "strict": true,
        "jsx": "react-jsx",
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "noUncheckedSideEffectImports": true,
        "moduleDetection": "force",
        "skipLibCheck": true
    }
}
