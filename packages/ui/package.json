{
	"name": "@vesta-cx/ui",
	"version": "0.0.1",
	"scripts": {
		"clean": "cleanc clean",
		"build:clean": "pnpm run clean && pnpm run build",
		"dev:clean": "pnpm run clean && pnpm run dev",
		"install:clean": "pnpm run clean && node -e \"try{require('fs').rmSync(require('path').join(process.cwd(),'node_modules'),{recursive:true,force:true})}catch(_){}\" && pnpm i",
		"dev": "vite dev --host -m dev",
		"dev:local": "vite dev -m dev",
		"build": "vite build && pnpm run prepack",
		"preview": "pnpm run build && wrangler dev",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "pnpm run test:unit -- --run && pnpm run test:e2e",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types ./src/worker-configuration.d.ts"
	},
	"files": [
		"dist",
		"dist/**/*.d.ts",
		"dist/**/*.js",
		"dist/**/*.scss",
		"dist/**/*.svelte",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"imports": {
		"#*": "./src/*"
	},
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./components/layout": {
			"types": "./dist/components/layout/index.d.ts",
			"svelte": "./dist/components/layout/index.js"
		},
		"./components/layout/*": {
			"types": "./dist/components/layout/*/index.d.ts",
			"svelte": "./dist/components/layout/*/index.js"
		},
		"./components/ui/*": {
			"types": "./dist/components/ui/*/index.d.ts",
			"svelte": "./dist/components/ui/*/index.js"
		},
		"./components/ui/utils/*": {
			"types": "./dist/components/ui/utils/*/index.d.ts",
			"svelte": "./dist/components/ui/utils/*/index.js"
		},
		"./components/utils/*": {
			"types": "./dist/components/utils/*/index.d.ts",
			"svelte": "./dist/components/utils/*/index.js"
		},
		"./components/*": {
			"types": "./dist/components/*.d.ts",
			"svelte": "./dist/components/*.js"
		},
		"./styles/*": {
			"default": "./dist/styles/*"
		},
		"./utils/*": {
			"types": "./dist/utils/*.d.ts",
			"default": "./dist/utils/*.js"
		}
	},
	"peerDependencies": {
		"@lucide/svelte": "^0.544.0",
		"@sveltejs/kit": "^2.0.0",
		"@vesta-cx/utils": "^1.0.0",
		"bits-ui": "^2.14.2",
		"layerchart": "^2.0.0-next.27",
		"nanostores": "^1.0.0",
		"svelte": "^5.0.0",
		"svelte-sonner": "^1.0.5"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.2",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.12.0",
		"@internationalized/date": "^3.11.0",
		"@lucide/svelte": "^0.575.0",
		"@nanostores/persistent": "^1.3.3",
		"@playwright/test": "^1.58.2",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.53.0",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.0",
		"@tanstack/table-core": "^8.21.3",
		"@types/d3": "^7.4.3",
		"@types/node": "^25.3.0",
		"@vesta-cx/config": "workspace:^",
		"@vesta-cx/utils": "workspace:^",
		"@vitest/browser": "^4.0.18",
		"@vitest/coverage-v8": "^4.0.18",
		"bits-ui": "^2.16.2",
		"clsx": "^2.1.1",
		"embla-carousel-svelte": "^8.6.0",
		"eslint": "^10.0.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.15.0",
		"formsnap": "^2.0.1",
		"globals": "^17.3.0",
		"layerchart": "2.0.0-next.27",
		"mdsvex": "^0.12.6",
		"mode-watcher": "^1.1.0",
		"nanostores": "^1.1.0",
		"paneforge": "^1.0.2",
		"playwright": "^1.58.2",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.0",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"publint": "^0.3.17",
		"sass": "^1.97.3",
		"sass-embedded": "^1.97.3",
		"svelte": "^5.53.2",
		"svelte-check": "^4.4.3",
		"svelte-preprocess": "^6.0.3",
		"svelte-reactive-preprocessor": "^0.8.3",
		"svelte-sonner": "^1.0.7",
		"sveltekit-superforms": "^2.29.1",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.56.0",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^7.3.1",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^4.0.18",
		"vitest-browser-svelte": "^2.0.2",
		"wrangler": "^4.67.0"
	},
	"keywords": [
		"svelte",
		"vesta",
		"shadcn-svelte",
		"bits-ui",
		"tailwind",
		"components"
	],
	"dependencies": {
		"@fontsource-variable/archivo": "^5.2.8",
		"@fontsource/geist-sans": "^5.2.5",
		"@solar-icons/svelte": "^1.1.0",
		"d3": "^7.9.0"
	},
	"description": "Svelte 5 component library for Vesta: shadcn-svelte, Bits-UI, OKLCH design tokens, layout. Use in SvelteKit; extend, do not rebuild.",
	"repository": {
		"type": "git",
		"url": "https://github.com/vesta-cx/ui.git"
	},
	"homepage": "https://github.com/vesta-cx/ui#readme",
	"bugs": {
		"url": "https://github.com/vesta-cx/ui/issues"
	},
	"author": "vesta-cx"
}
