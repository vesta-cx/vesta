{
  "name": "@vesta-cx/utils",
  "version": "1.0.0",
  "description": "Shared utilities for Vesta: colors, easing, numbers, permissions, cookies, and CORS. ESM + CJS.",
  "keywords": [
    "vesta",
    "utils",
    "cors",
    "cookies"
  ],
  "homepage": "https://github.com/vesta-cx/utils#readme",
  "bugs": {
    "url": "https://github.com/vesta-cx/utils/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vesta-cx/utils.git"
  },
  "license": "ISC",
  "author": "vesta-cx",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./cookies": {
      "types": "./dist/cookies/index.d.ts",
      "require": "./dist/cookies/index.js",
      "import": "./dist/cookies/index.js"
    },
    "./cors": {
      "types": "./dist/cors/index.d.ts",
      "require": "./dist/cors/index.js",
      "import": "./dist/cors/index.js"
    }
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "build:clean": "pnpm run clean && pnpm run build",
    "clean": "cleanc clean",
    "dev": "tsc --watch",
    "dev:clean": "pnpm run clean && pnpm run dev",
    "format": "prettier --write .",
    "install:clean": "pnpm run clean && node -e \"try{require('fs').rmSync(require('path').join(process.cwd(),'node_modules'),{recursive:true,force:true})}catch(_){}\" && pnpm i",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nanostores/persistent": "^1.3.3",
    "nanostores": "^1.1.0"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.53.0",
    "@types/node": "^25.3.0",
    "@vesta-cx/config": "workspace:*",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.0.1",
    "happy-dom": "^20.7.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@sveltejs/kit": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be"
}
